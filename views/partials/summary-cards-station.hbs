 <div class ="columns is-flex-is-align-items-stretch">
    <div class = "column">
  <div class = "card">
    <header class = "card-header">
    <p class = "card-header-title">
      {{station.title}}
      </p>
      {{>icons/location}}
    </header>
    <div class = "card-content">
      <p>
        Lat: {{station.lat}}
      </p>
      <p>
        Long: {{station.long}}
      </p>
    </div>
  </div>
       </div>
    <div class = "column">
  <div class = "card">
    <header class = "card-header">
    <p class = "card-header-title">
      Weather
      </p>
<img src = "{{station.weatherIcon}}" width ="48" height ="48" onerror="this.src='https://cdn.glitch.global/d6973480-5b8e-463f-a315-d8ad6ba2634d/weatherMap.png?v=1724950952749'">
    </header>
    <div class = "card-content">
      <p>
        {{station.weather}}
      </p>
    </div>
  </div>
       </div>
        <div class = "column">
  <div class = "card">
    <header class = "card-header">
    <p class = "card-header-title">
      Temperature
      </p>
<img src = "{{station.tempIconPath}}" width = "48" height = "48" alt = "" onerror="this.src='https://cdn.glitch.global/d6973480-5b8e-463f-a315-d8ad6ba2634d/celcius.png?v=1724950955411'">
    </header>
    <div class = "card-content">
      <p>
        Current: {{station.currentTemp}}°C
      </p>
            <p>
        Current: {{station.currentTempFarenheit}}°F
      </p>
      <p>
        Feels like: {{station.windChill}}°C
      </p>
      <p>
        Max: {{station.maxTemp}}°C
      </p>
      <p>
        Min: {{station.minTemp}}°C
      </p>
    </div>
  </div>
       </div>
        <div class = "column">
  <div class = "card">
    <header class = "card-header">
    <p class = "card-header-title">
      Wind
      </p>
      <img class="image" src = "{{station.windDirectionIcon}}" width = "48" height = "48" alt = "" onerror="this.src='https://cdn.glitch.global/d6973480-5b8e-463f-a315-d8ad6ba2634d/wind.png?v=1724950949850'" >
    </header>
    <div class = "card-content">
      <p>
      {{station.windType}}
      </p>
      <p>
        Direction: {{station.windDirectionCompass}}
      </p>
      <p>
        Current: {{station.currentWind}}Km/h
      </p>
      <p>
        Current: {{station.currentWindMph}}Mph
      </p>
      <p>
        Max: {{station.maxWind}}Km/h
      </p>
      <p>
        Min: {{station.minWind}}Km/h
      </p>
    </div>
  </div>
       </div>
        <div class = "column">
  <div class = "card">
    <header class = "card-header">
    <p class = "card-header-title">
      Pressure
      </p>
      {{>icons/pressure}}
    </header>
    <div class = "card-content">
      <p>
        Current: {{station.currentPressure}}hPa
      </p>
      <p>
        Max: {{station.maxPressure}}hPa
      </p>
        <p>
        Min: {{station.minPressure}}hPa
      </p>
    </div>
  </div>
       </div>
</div>