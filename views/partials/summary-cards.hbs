
<div class ="columns is-flex-is-align-items-stretch">
    <div class = "column">
  <div class = "card">
    <header class = "card-header">
    <p class = "card-header-title">
      {{title}}
      </p>
      {{>icons/location}}
    </header>
    <div class = "card-content">
      <p>
        Lat: {{lat}}
      </p>
      <p>
        Long: {{long}}
      </p>
    </div>
  </div>
       </div>
    <div class = "column">
  <div class = "card">
    <header class = "card-header">
    <p class = "card-header-title">
      Weather
      </p>
<img src = "{{weatherIcon}}" width ="48" height ="48">
    </header>
    <div class = "card-content">
      <p>
        {{weather}}
      </p>
    </div>
  </div>
       </div>
        <div class = "column">
  <div class = "card">
    <header class = "card-header">
    <p class = "card-header-title">
      Temperature
      </p>
<img src = "{{tempIconPath}}" width = "48" height = "48" alt = "temp">
    </header>
    <div class = "card-content">
      <p>
        Current: {{currentTemp}}°C
      </p>
            <p>
        Current: {{currentTempFarenheit}}°F
      </p>
      <p>
        Feels like: {{windChill}}°C
      </p>
      <p>
        Max: {{maxTemp}}°C
      </p>
      <p>
        Min: {{minTemp}}°C
      </p>
    </div>
  </div>
       </div>
        <div class = "column">
  <div class = "card">
    <header class = "card-header">
    <p class = "card-header-title">
      Wind
      </p>
      <img src = "{{windDirectionIcon}}" width = "48" height = "48" alt = "direction">
    </header>
    <div class = "card-content">
      <p>
      {{windType}}
      </p>
      <p>
        Direction: {{station.windDirectionCompass}}
      </p>
      <p>
        Current: Km/h
      </p>
      <p>
        Current: {{currentWindMph}}Mph
      </p>
      <p>
        Max: {{maxWind}}Km/h
      </p>
      <p>
        Min: {{minWind}}Km/h
      </p>
    </div>
  </div>
       </div>
        <div class = "column">
  <div class = "card">
    <header class = "card-header">
    <p class = "card-header-title">
      Pressure
      </p>
      {{>icons/pressure}}
    </header>
    <div class = "card-content">
      <p>
        Current: {{currentPressure}}hPa
      </p>
      <p>
        Max: {{maxPressure}}hPa
      </p>
        <p>
        Min: {{minPressure}}hPa
      </p>
    </div>
  </div>
       </div>
</div>
