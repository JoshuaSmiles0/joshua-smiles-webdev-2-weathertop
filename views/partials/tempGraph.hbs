<div class="ui segment" id="chart1"></div>

<script>
  const data = {
    labels: [
      {{#each tempLabel}}
        "{{this}}",
      {{/each}}
    ],
    datasets: [
      {
        name: "Temp °C", type: "line",
        values: [
          {{#each tempTrend}}
            {{this}},
          {{/each}}
        ]
      }
    ]
  }

  const chart1 = new frappe.Chart("#chart1", {
    title: "Entered Reports Temperature Trends",
    data: data,
    type: 'line',
    height: 400,
    colours:['Red'],
  })
</script>

